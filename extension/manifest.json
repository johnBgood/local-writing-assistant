{
  "manifest_version": 3,
  "name": "LocalWriter",
  "version": "0.4.5",
  "description": "On-device multilingual writing suggestions powered by the LocalWriter Mac app.",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LocalWriter",
    "default_popup": "popup.html"
  },
  "key": "",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
